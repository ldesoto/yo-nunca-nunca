PORT=2567
# Local SQLite only — do NOT set DATABASE_URL (that is for CardNexus/LEADS).
# YNN_SQLITE_PATH=/Users/luisdesoto/yo-nunca-nunca/packages/db/data/ynn.sqlite

# Server (Fly / Docker): comma-separated CORS allowlist (optional custom domain)
# ALLOWED_ORIGINS=https://api.yonuncannunca.app

# Fly deploy (non-interactive: FLY_API_TOKEN from `flyctl tokens create deploy`)
# FLY_APP_NAME=yo-nunca-nunca
# FLY_REGION=iad
# FLY_API_TOKEN=

# Render fallback (render.yaml)
# RENDER_API_KEY=   # dashboard → Account Settings → API Keys

# --- Development (Expo on this Mac) ---
EXPO_PUBLIC_SERVER_URL=http://127.0.0.1:2567
EXPO_PUBLIC_WS_URL=ws://127.0.0.1:2567

# Render (default production — Render injects RENDER_EXTERNAL_URL in production)
# RENDER_SERVICE_NAME=yo-nunca-nunca

# --- Store / preview builds (must match deployed host — see README Producción) ---
# APP_ENV=production
# EXPO_PUBLIC_SERVER_URL=https://yo-nunca-nunca.onrender.com
# EXPO_PUBLIC_WS_URL=wss://yo-nunca-nunca.onrender.com
